{
  "_comment": [
    "Every image quorum-images.yml can build, published as ghcr.io/hivecommons/<repository>.",
    "Build contexts and Dockerfiles follow upstream's release build plan",
    "(release/candidate-image-map.mjs emit-build-plan), except: vexa-lite (not used by the Helm",
    "chart) and the dashboard (services/dashboard, a separate client with an unpinned base image)",
    "are not built; crm and signals are built although upstream publishes neither.",
    "kind: plain = one docker build; bot = vexa-meet-join-env then vexa-bot FROM it (two",
    "repositories, one job); stt = Dockerfile.cpu + transcription-cpu.overlay.Dockerfile.",
    "set: bot = the original three images (release-mode default); control = the chart's",
    "control-plane images. source=main always builds every set."
  ],
  "images": [
    { "name": "bot", "set": "bot", "kind": "bot", "repository": "vexa-bot",
      "repositories": ["vexa-meet-join-env", "vexa-bot"],
      "context": ".", "dockerfile": "core/meetings/services/bot/Dockerfile", "free_disk": true },
    { "name": "transcription-cpu", "set": "bot", "kind": "stt", "repository": "vexa-transcription-cpu",
      "repositories": ["vexa-transcription-cpu"],
      "context": ".", "dockerfile": "core/meetings/services/transcription/Dockerfile.cpu", "free_disk": true },
    { "name": "gateway", "set": "control", "kind": "plain", "repository": "vexa-gateway",
      "repositories": ["vexa-gateway"],
      "context": ".", "dockerfile": "core/gateway/services/gateway/Dockerfile" },
    { "name": "admin-api", "set": "control", "kind": "plain", "repository": "vexa-admin-api",
      "repositories": ["vexa-admin-api"],
      "context": "core/identity/services/admin-api", "dockerfile": "core/identity/services/admin-api/Dockerfile" },
    { "name": "meeting-api", "set": "control", "kind": "plain", "repository": "vexa-meeting-api",
      "repositories": ["vexa-meeting-api"],
      "context": ".", "dockerfile": "core/meetings/services/meeting-api/Dockerfile" },
    { "name": "runtime", "set": "control", "kind": "plain", "repository": "vexa-runtime",
      "repositories": ["vexa-runtime"],
      "context": "core/runtime", "dockerfile": "core/runtime/Dockerfile" },
    { "name": "mcp", "set": "control", "kind": "plain", "repository": "vexa-mcp",
      "repositories": ["vexa-mcp"],
      "context": "core/gateway/services/mcp", "dockerfile": "core/gateway/services/mcp/Dockerfile" },
    { "name": "agent-api", "set": "control", "kind": "plain", "repository": "vexa-agent-api",
      "repositories": ["vexa-agent-api"],
      "context": ".", "dockerfile": "core/agent/services/agent-api/Dockerfile" },
    { "name": "agent-worker", "set": "control", "kind": "plain", "repository": "vexa-agent-worker",
      "repositories": ["vexa-agent-worker"],
      "context": ".", "dockerfile": "core/agent/worker/Dockerfile" },
    { "name": "credential-broker", "set": "control", "kind": "plain", "repository": "vexa-credential-broker",
      "repositories": ["vexa-credential-broker"],
      "context": "core/agent/services/credential-broker", "dockerfile": "core/agent/services/credential-broker/Dockerfile" },
    { "name": "flows", "set": "control", "kind": "plain", "repository": "vexa-flows",
      "repositories": ["vexa-flows"],
      "context": ".", "dockerfile": "core/flows/Dockerfile" },
    { "name": "terminal", "set": "control", "kind": "plain", "repository": "vexa-terminal",
      "repositories": ["vexa-terminal"],
      "context": "clients/terminal", "dockerfile": "clients/terminal/Dockerfile",
      "build_args": "NEXT_PUBLIC_TERMINAL_MODE=minutes", "free_disk": true },
    { "name": "crm", "set": "control", "kind": "plain", "repository": "vexa-crm",
      "repositories": ["vexa-crm"],
      "context": "core/crm", "dockerfile": "core/crm/Dockerfile" },
    { "name": "signals", "set": "control", "kind": "plain", "repository": "vexa-signals",
      "repositories": ["vexa-signals"],
      "context": "core/signals", "dockerfile": "core/signals/Dockerfile" }
  ]
}
